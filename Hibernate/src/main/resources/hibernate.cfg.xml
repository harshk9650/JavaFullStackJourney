<!DOCTYPE hibernate-configuration PUBLIC
	"-//Hibernate/Hibernate Configuration DTD 3.0//EN"
	"http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>
       <property name="hibernate.conection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <property name="hibernate.conection.url">jdbc:myql://localhost:3306/hibernate_db</property>
        <property name="hibernate.conection.username">root</property>
        <property name="hibernate.conection.password">Harsh@2311</property>
        <property name="hbm2ddl.auto">update</property>
        <property name="show_sql">true</property>
        <mapping class="org.example.Mydto"/>

        
        
        
        
        
    </session-factory>
</hibernate-configuration>
